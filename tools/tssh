#!/bin/sh
# SSH into the device as root with the maintenance key: USB-C link by default,
# WALLPANEL_HOST=<wlan ip> tools/tssh ... for WiFi.
exec ssh -i "$(dirname "$0")/ssh/id_ed25519" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o LogLevel=ERROR "root@${WALLPANEL_HOST:-10.42.0.1}" "$@"
