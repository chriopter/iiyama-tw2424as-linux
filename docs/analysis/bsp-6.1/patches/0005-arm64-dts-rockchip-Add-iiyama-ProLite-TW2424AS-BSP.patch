+/* Same magic values as the vendor U-Boot (reboot bootloader/loader work) */
+&pmugrf {
+	reboot-mode {
+		compatible = "syscon-reboot-mode";
+		offset = <0x300>;
+		mode-bootloader = <0x5242c309>;
+		mode-charge = <0x5242c30b>;
+		mode-fastboot = <0x5242c309>;
+		mode-loader = <0x5242c301>;
+		mode-normal = <0x5242c300>;
+		mode-recovery = <0x5242c303>;
+		mode-ums = <0x5242c30c>;
+	};
+};
+
+/*
+ * Same ramoops layout as the vendor Android kernel, so a log written by this
+ * kernel can be read back from /sys/fs/pstore after rebooting into Android.
+ * rk3399-linux.dtsi places the node outside /reserved-memory with a
+ * memory-region phandle, which fs/pstore/ram.c does not support, and uses
+ * two-cell sizes that the driver reads as 0; replace it.
+ */
+/delete-node/ &ramoops;
+/delete-node/ &ramoops_mem;
+
+&{/reserved-memory} {
+	ramoops@110000 {
+		compatible = "ramoops";
+		reg = <0x0 0x110000 0x0 0xf0000>;
+		record-size = <0x20000>;
+		console-size = <0x80000>;
+		ftrace-size = <0x0>;
+		pmsg-size = <0x50000>;
+	};
+};
