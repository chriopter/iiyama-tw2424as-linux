+&dsi {
+	/* TC358775 needs the HS clock running while it receives LP register writes */
+	rockchip,lp-cmd-hs-clk;
+	status = "okay";
+
+	/*
+	 * Toshiba TC358775 DSI-to-dual-LVDS bridge, programmed with DSI generic
+	 * writes (register sequence copied verbatim from the vendor firmware).
+	 */
+	panel@0 {
+		compatible = "simple-panel-dsi";
+		reg = <0>;
+		backlight = <&backlight>;
+		power-supply = <&vcc_en_lcd>;
+		reset-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
+		/* VIDEO | VIDEO_BURST | NO_EOT_PACKET | LPM, raw vendor value */
+		dsi,flags = <0xa03>;
+		dsi,format = <MIPI_DSI_FMT_RGB888>;
+		dsi,lanes = <4>;
+		bpc = <8>;
+		/* The panel is mounted upside down (Android: primary_display_orientation=180) */
+		rotation = <180>;
+		prepare-delay-ms = <120>;
+		reset-delay-ms = <120>;
+		init-delay-ms = <120>;
+		stbyb-delay-ms = <120>;
+		enable-delay-ms = <120>;
+		disable-delay-ms = <120>;
+		unprepare-delay-ms = <120>;
+		/*
+		 * The first write starts the DSI HS clock after the bridge left reset
+		 * (see rockchip,lp-cmd-hs-clk) and is likely lost; repeat it after
+		 * 20 ms, then the vendor sequence follows unchanged.
+		 */
+		panel-init-sequence = [
+			29 14 06 3c 01 0c 00 0a 00
+			29 05 06 3c 01 0c 00 0a 00
+			29 05 06 14 01 08 00 00 00
+			29 05 06 64 01 0f 00 00 00
+			29 05 06 68 01 0f 00 00 00
+			29 05 06 6c 01 0f 00 00 00
+			29 05 06 70 01 0f 00 00 00
+			29 05 06 34 01 1f 00 00 00
+			29 05 06 10 02 1f 00 00 00
+			29 05 06 04 01 01 00 00 00
+			29 05 06 04 02 01 00 00 00
+			29 05 06 50 04 20 01 f0 03
+			29 05 06 54 04 28 00 46 00
+			29 05 06 58 04 80 07 46 00
+			29 05 06 5c 04 05 00 0a 00
+			29 05 06 60 04 38 04 0f 00
+			29 05 06 64 04 01 00 00 00
+			29 05 06 a0 04 06 80 44 00
+			29 0a 06 a0 04 06 80 04 00
+			29 05 06 04 05 04 00 00 00
+			29 05 06 80 04 00 02 02 03
+			29 05 06 84 04 04 07 05 08
+			29 05 06 88 04 09 0a 0e 0f
+			29 05 06 8c 04 0b 0c 0d 10
+			29 05 06 90 04 16 17 11 12
+			29 05 06 94 04 13 14 15 1b
+			29 05 06 98 04 18 19 1a 06
+			29 32 06 9c 04 33 00 00 00
+		];
+
+		display-timings {
+			native-mode = <&timing_tw2424as>;
+
+			timing_tw2424as: timing0 {
+				clock-frequency = <137860000>;
+				hactive = <1920>;
+				vactive = <1080>;
+				hback-porch = <70>;
+				hsync-len = <40>;
+				hfront-porch = <70>;
+				vback-porch = <10>;
+				vfront-porch = <15>;
+				vsync-len = <5>;
+				hsync-active = <0>;
+				vsync-active = <0>;
+				de-active = <0>;
+				pixelclk-active = <0>;
+			};
+		};
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				panel_in_dsi: endpoint {
+					remote-endpoint = <&dsi_out_panel>;
+				};
+			};
+		};
+	};
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+			dsi_out_panel: endpoint {
+				remote-endpoint = <&panel_in_dsi>;
+			};
+		};
+	};
+};
