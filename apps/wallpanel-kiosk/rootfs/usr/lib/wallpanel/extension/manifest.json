{
  "manifest_version": 3,
  "name": "wallpanel",
  "version": "1.0",
  "description": "Kiosk helpers: keep the browser on the configured home URL, reduce repaint cost of dashboard cards, work around card bugs, let the update page frame Home Assistant (scaling preview).",
  "permissions": [
    "webNavigation",
    "tabs",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "contain.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fixes.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
