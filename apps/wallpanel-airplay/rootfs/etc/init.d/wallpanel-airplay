#!/sbin/openrc-run
description="Wallpanel AirPlay receiver (shairport-sync, AirPlay 1 / RAOP)"
supervisor=supervise-daemon
command=/usr/bin/shairport-sync
command_args="-c /run/wallpanel-airplay/shairport-sync.conf"
command_user=airplay:airplay
respawn_delay=5
respawn_max=0
# shairport-sync 5.0.4 can hang after an internal fatal error and then ignores SIGTERM
retry="TERM/5/KILL/2"
# ... and without its RTSP listener: restart it when the port is gone
healthcheck_delay=60
healthcheck_timer=60
output_log=/var/log/wallpanel-airplay.log
error_log=/var/log/wallpanel-airplay.log

# Fixed ports, so a firewall rule is possible: RTSP (TCP) and the UDP range for audio/control/timing.
AIRPLAY_PORT=5000
AIRPLAY_UDP_BASE=6001
AIRPLAY_UDP_RANGE=10

depend() {
	need net avahi-daemon
	after wallpanel-kiosk
}

healthcheck() {
	netstat -tln 2>/dev/null | grep -q ":$AIRPLAY_PORT "
}

# libconfig string: escape backslash and double quote
q() { printf '%s' "$1" | sed 's/[\\"]/\\&/g'; }

start_pre() {
	# unprivileged user, may only use the sound devices (group audio); idempotent
	getent group airplay >/dev/null || addgroup -S airplay
	getent passwd airplay >/dev/null || adduser -S -D -H -h /var/empty -s /sbin/nologin -G airplay airplay
	id -nG airplay | grep -qw audio || addgroup airplay audio

	# DEVICE_NAME and optional AIRPLAY_PASSWORD from the shared wallpanel.conf (single-quoted shell values)
	local DEVICE_NAME= AIRPLAY_PASSWORD=
	[ -r /etc/wallpanel/wallpanel.conf ] && . /etc/wallpanel/wallpanel.conf
	checkpath -d -m 0750 -o root:airplay /run/wallpanel-airplay
	(
		umask 027
		cat > /run/wallpanel-airplay/shairport-sync.conf.new <<-EOF
		// generated by /etc/init.d/wallpanel-airplay from /etc/wallpanel/wallpanel.conf
		general = {
			name = "$(q "$(printf '%s' "${DEVICE_NAME:-Wallpanel}" | cut -c1-50)")";
			$([ -n "$AIRPLAY_PASSWORD" ] && printf 'password = "%s";' "$(q "$AIRPLAY_PASSWORD")")
			port = $AIRPLAY_PORT;
			udp_port_base = $AIRPLAY_UDP_BASE;
			udp_port_range = $AIRPLAY_UDP_RANGE;
			// AirPlay volume -30..0 -> DAC -50..0 dB, linear in dB: same scale as the panel volume
			// (wallpanel-api: 100 % = 0 dB, 0.5 dB per %), so AirPlay 20 % = panel 20 %.
			volume_range_db = 50;
			volume_max_db = 0.0;
			volume_control_profile = "flat";
		};
		sessioncontrol = {
			allow_session_interruption = "yes";
		};
		alsa = {
			// 44.1 kHz rate plugin into the shared dmix (/etc/alsa/conf.d/60-wallpanel-airplay.conf);
			// never hw:0,0 directly: that would block Chromium
			output_device = "wallpanel_airplay";
			mixer_control_name = "DAC";
			mixer_device = "hw:iiyamatw2424as";
			output_rate = 44100;
			output_format = "S16_LE";
			output_channels = 2;
			disable_standby_mode = "never";
		};
		metadata = {
			enabled = "no";
		};
		EOF
	) || return 1
	chown root:airplay /run/wallpanel-airplay/shairport-sync.conf.new
	mv -f /run/wallpanel-airplay/shairport-sync.conf.new /run/wallpanel-airplay/shairport-sync.conf

	# keep the log small on the eMMC: rotate once it exceeds 1 MiB
	[ "$(stat -c %s /var/log/wallpanel-airplay.log 2>/dev/null || echo 0)" -lt 1048576 ] || mv -f /var/log/wallpanel-airplay.log /var/log/wallpanel-airplay.log.old
	checkpath -f -m 0644 -o airplay:airplay /var/log/wallpanel-airplay.log
}
