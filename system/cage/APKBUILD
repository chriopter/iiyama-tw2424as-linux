c58d6a54751646f37e2d8263b39f48a15f926193b0d40b3ca5702d5da0b1c2bf9da3dd3e75738ac9e63fcf58709f1e2eda7887a0d957d39254a84e9a944a6eab  0001-Apply-gamma-ramps-from-the-gamma-control-protocol.patch
