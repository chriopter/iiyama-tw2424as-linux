# Contributor: Will Sinatra <wpsinatra@gmail.com> (Alpine aports community/cage)
# Maintainer: chriopter <82179548+chriopter@users.noreply.github.com>
#
# Wallpanel build of cage, derived from Alpine aports community/cage (commit in VERSION).
# Local changes: patches/ (gamma control, xwayland option), XWayland and man pages off,
# no cage-run/-doc subpackages; pkgrel 100+ marks the wallpanel build (sorts above any Alpine
# rebuild of the same version). Build with ./build.sh cage; sha512sums via ./build.sh export cage.
pkgname=cage
pkgver=0.3.0
pkgrel=100
pkgdesc="Wayland Kiosk (wallpanel build: gamma control, no XWayland)"
url="https://www.hjdskes.nl/projects/cage/"
license="MIT"
arch="aarch64"
options="!check" # no test suite
makedepends="meson wlroots0.20-dev wayland-protocols"
source="$pkgname-$pkgver.tar.gz::https://github.com/cage-kiosk/cage/archive/refs/tags/v$pkgver.tar.gz
	0001-Apply-gamma-ramps-from-the-gamma-control-protocol.patch
	0002-build-Add-an-xwayland-feature-option.patch
	"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dxwayland=disabled \
		-Dman-pages=disabled \
		build
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

