From ebb45c35f9c8ee4a951ebca6463fa6411536144c Mon Sep 17 00:00:00 2001
From: chriopter <82179548+chriopter@users.noreply.github.com>
Date: Tue, 29 Sep 2026 15:02:12 +0200
Subject: [PATCH 2/2] configs: Add iiyama TW2424AS RAM-only loader

Maskrom RAM-boot loader for the iiyama ProLite TW2424AS: no environment,
no eMMC write support, fastboot (boot only) plus oem run for diagnostics.

---
 configs/iiyama-tw2424as-ramboot_defconfig | 100 ++++++++++++++++++++++
 1 file changed, 100 insertions(+)
 create mode 100644 configs/iiyama-tw2424as-ramboot_defconfig

diff --git a/configs/iiyama-tw2424as-ramboot_defconfig b/configs/iiyama-tw2424as-ramboot_defconfig
new file mode 100644
index 00000000..056baae8
--- /dev/null
+++ b/configs/iiyama-tw2424as-ramboot_defconfig
@@ -0,0 +1,100 @@
+CONFIG_ARM=y
+CONFIG_SKIP_LOWLEVEL_INIT=y
+CONFIG_COUNTER_FREQUENCY=24000000
+CONFIG_ARCH_ROCKCHIP=y
+CONFIG_NR_DRAM_BANKS=1
+CONFIG_SF_DEFAULT_SPEED=25000000
+CONFIG_DEFAULT_DEVICE_TREE="rk3399-generic"
+CONFIG_DM_RESET=y
+CONFIG_ROCKCHIP_RK3399=y
+CONFIG_ROCKCHIP_EXTERNAL_TPL=y
+CONFIG_TARGET_EVB_RK3399=y
+CONFIG_SYS_LOAD_ADDR=0x800800
+CONFIG_SF_DEFAULT_BUS=1
+CONFIG_DEBUG_UART_BASE=0xFF1A0000
+CONFIG_DEBUG_UART_CLOCK=24000000
+CONFIG_DEBUG_UART=y
+CONFIG_FIT_VERBOSE=y
+# CONFIG_BOOTMETH_VBE is not set
+CONFIG_DEFAULT_FDT_FILE="rockchip/rk3399-generic.dtb"
+# CONFIG_DISPLAY_CPUINFO is not set
+CONFIG_SPL_MAX_SIZE=0x40000
+# CONFIG_SPL_RAW_IMAGE_SUPPORT is not set
+CONFIG_SPL_ATF_NO_PLATFORM_PARAM=y
+CONFIG_CMD_MEMINFO=y
+CONFIG_CMD_MEMINFO_MAP=y
+CONFIG_CMD_GPIO=y
+CONFIG_CMD_MISC=y
+# CONFIG_CMD_SETEXPR is not set
+CONFIG_CMD_RNG=y
+# CONFIG_SPL_DOS_PARTITION is not set
+CONFIG_SPL_OF_CONTROL=y
+# CONFIG_OF_UPSTREAM is not set
+CONFIG_OF_SPL_REMOVE_PROPS="clock-names interrupt-parent assigned-clocks assigned-clock-rates assigned-clock-parents"
+CONFIG_ENV_RELOC_GD_ENV_ADDR=y
+CONFIG_NO_NET=y
+# CONFIG_ADC is not set
+CONFIG_ROCKCHIP_GPIO=y
+# CONFIG_ROCKCHIP_IODOMAIN is not set
+CONFIG_MMC_DW=y
+CONFIG_MMC_DW_ROCKCHIP=y
+CONFIG_MMC_SDHCI=y
+CONFIG_MMC_SDHCI_SDMA=y
+CONFIG_MMC_SDHCI_ROCKCHIP=y
+CONFIG_SPI_FLASH_SFDP_SUPPORT=y
+CONFIG_SPI_FLASH_GIGADEVICE=y
+CONFIG_SPI_FLASH_MACRONIX=y
+CONFIG_SPI_FLASH_SILICONKAISER=y
+CONFIG_SPI_FLASH_WINBOND=y
+CONFIG_SPI_FLASH_XMC=y
+CONFIG_SPI_FLASH_XTX=y
+CONFIG_SPI_FLASH_ZBIT=y
+CONFIG_PHY_ROCKCHIP_INNO_USB2=y
+CONFIG_BAUDRATE=1500000
+CONFIG_DEBUG_UART_SHIFT=2
+CONFIG_SYS_NS16550_MEM32=y
+CONFIG_ROCKCHIP_SPI=y
+CONFIG_SYSRESET=y
+CONFIG_SYSRESET_PSCI=y
+CONFIG_USB=y
+CONFIG_USB_DWC3=y
+CONFIG_USB_DWC3_GENERIC=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_GADGET_DOWNLOAD=y
+CONFIG_ERRNO_STR=y
+# --- iiyama TW2424AS RAM-only loader (maskrom USB boot) ---
+CONFIG_ROCKCHIP_MASKROM_IMAGE=y
+CONFIG_ENV_IS_NOWHERE=y
+# CONFIG_ENV_IS_IN_MMC is not set
+# CONFIG_ENV_IS_IN_SPI_FLASH is not set
+# CONFIG_CMD_SAVEENV is not set
+# CONFIG_MMC_WRITE is not set
+# CONFIG_CMD_MMC is not set
+# CONFIG_SPI_FLASH_MTD is not set
+CONFIG_USB_FUNCTION_FASTBOOT=y
+CONFIG_CMD_FASTBOOT=y
+# CONFIG_FASTBOOT_FLASH is not set
+CONFIG_FASTBOOT_BUF_ADDR=0x30000000
+CONFIG_FASTBOOT_BUF_SIZE=0x08000000
+CONFIG_ANDROID_BOOT_IMAGE=y
+CONFIG_CMD_BOOTI=y
+CONFIG_BOOTDELAY=0
+CONFIG_USE_BOOTCOMMAND=y
+CONFIG_BOOTCOMMAND="gpio set B1; gpio set B3; gpio set B19; gpio clear B10; fastboot usb 0; reset"
+# CONFIG_BOOTSTD_DEFAULTS is not set
+CONFIG_USB_GADGET_MANUFACTURER="iiyama-ramboot"
+CONFIG_USB_GADGET_VENDOR_NUM=0x18d1
+CONFIG_USB_GADGET_PRODUCT_NUM=0x4ee0
+# Hardware watchdog: a hang after U-Boot warm-resets the board (RAM kept for
+# ramoops); the BSP kernel's dw_wdt keeps pinging a running watchdog.
+CONFIG_WDT=y
+CONFIG_DESIGNWARE_WATCHDOG=y
+CONFIG_WATCHDOG_AUTOSTART=y
+CONFIG_WATCHDOG_TIMEOUT_MSECS=20000
+# Remote diagnostics over fastboot: "oem run:<cmd>" and "oem console"
+CONFIG_FASTBOOT_OEM_RUN=y
+CONFIG_CONSOLE_RECORD=y
+CONFIG_CONSOLE_RECORD_OUT_SIZE=0x10000
+CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y
+CONFIG_CMD_WDT=y
+CONFIG_CMD_MEMORY=y
