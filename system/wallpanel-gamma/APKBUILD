# Maintainer: chriopter <82179548+chriopter@users.noreply.github.com>
#
# Wallpanel's own gamma helper (source in this directory, no upstream): holds the wlr-gamma-control
# of the kiosk output and sets colour temperatures read from stdin without releasing it.
# pkgver = meson.build project version; bump pkgrel for packaging-only changes, reset it to 0 with a
# new pkgver. Build with ./build.sh wallpanel-gamma (refreshes sha512sums).
pkgname=wallpanel-gamma
pkgver=1.1.0
pkgrel=0
pkgdesc="Flicker-free colour temperature for the wallpanel kiosk (wlr-gamma-control from stdin)"
url="https://github.com/chriopter/iiyama-tw2424as-linux"
license="MIT"
arch="aarch64"
options="!check" # no test suite
makedepends="meson wayland-dev wlr-protocols"
source="meson.build
	wallpanel-gamma.c
	"
builddir="$srcdir"

build() {
	abuild-meson \
		-Db_lto=true \
		. build
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

sha512sums="
