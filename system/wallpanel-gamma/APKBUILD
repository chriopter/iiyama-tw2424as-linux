d7674e0b7fc8761f8a21aa9f68124fad38453457077a8ee42296b01c0fa103db86231ebf0519d26520f8c0097fd3a0d0e06f6110f62ce2ccfc3084f25c7d9cb9  wallpanel-gamma.c
"
