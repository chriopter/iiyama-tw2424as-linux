From 2b10d182b9e72f6def4f1f72d617220765ea0c7a Mon Sep 17 00:00:00 2001
From: chriopter <82179548+chriopter@users.noreply.github.com>
Date: Tue, 29 Sep 2026 14:59:00 +0200
Subject: [PATCH 03/12] drm/panel: Add iiyama ProLite TW2424AS panel

Add a driver for the internal panel of the iiyama ProLite TW2424AS panel
PC: a TC358775 DSI-to-dual-LVDS bridge programmed with DSI generic writes
(register values from the vendor firmware) in front of a 1920x1080 panel.

The bridge only latches LP register writes while the DSI HS clock runs,
and only if that clock was started after the bridge left reset. As the
DSI host starts the HS clock before preparing the panel, release the
bridge reset once at probe time and only (re)program it in prepare.
---
 drivers/gpu/drm/panel/Kconfig                 |  11 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 drivers/gpu/drm/panel/panel-iiyama-tw2424as.c | 259 ++++++++++++++++++
 3 files changed, 271 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-iiyama-tw2424as.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 3eac4d0f8..6a9e9f3d2 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -265,6 +265,17 @@ config DRM_PANEL_HYDIS_HV101HD1
 
 	  If M is selected the module will be called panel-hydis-hv101hd1
 
+config DRM_PANEL_IIYAMA_TW2424AS
+	tristate "iiyama ProLite TW2424AS panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here to enable support for the internal display of the
+	  iiyama ProLite TW2424AS panel PC: a 1920x1080 dual-link LVDS
+	  panel behind a Toshiba TC358775 bridge that is programmed over
+	  MIPI-DSI.
+
 config DRM_PANEL_ILITEK_IL9322
 	tristate "Ilitek ILI9322 320x240 QVGA panels"
 	depends on OF && SPI
