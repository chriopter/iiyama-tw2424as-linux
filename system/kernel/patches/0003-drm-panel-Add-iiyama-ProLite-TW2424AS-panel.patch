diff --git a/drivers/gpu/drm/panel/panel-iiyama-tw2424as.c b/drivers/gpu/drm/panel/panel-iiyama-tw2424as.c
new file mode 100644
index 000000000..60baae029
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-iiyama-tw2424as.c
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * iiyama ProLite TW2424AS panel
+ *
+ * The RK3399 drives a Toshiba TC358775 DSI-to-dual-LVDS bridge whose I2C bus
+ * is not wired up; the bridge is programmed through DSI generic long writes
+ * (2 byte little-endian register address followed by a 32 bit value) before
+ * the video stream starts. Register values are taken from the vendor
+ * Android 12 device tree.
+ *
+ * The bridge only latches register writes received in LP mode while the DSI
+ * HS clock is running, and only if that clock was started after the bridge
+ * left reset. The DSI host starts the HS clock in its pre-enable step, before
+ * the panel is prepared, so the bridge is taken out of reset once at probe
+ * time (before any DSI activity) and is not reset again afterwards.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct tw2424as {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+
+	struct regulator *power;
+	struct gpio_desc *reset;
+	enum drm_panel_orientation orientation;
+};
+
+static inline struct tw2424as *panel_to_tw2424as(struct drm_panel *panel)
+{
+	return container_of(panel, struct tw2424as, panel);
+}
+
+/* Write one 32 bit bridge register; the vendor sequence waits 5 ms after each */
+static void tc_write(struct mipi_dsi_multi_context *ctx, u16 reg, u32 val)
+{
+	u8 buf[6] = {
+		reg & 0xff, reg >> 8,
+		val & 0xff, (val >> 8) & 0xff, (val >> 16) & 0xff, val >> 24,
+	};
+
+	mipi_dsi_generic_write_multi(ctx, buf, sizeof(buf));
+	mipi_dsi_msleep(ctx, 5);
+}
+
+static void tw2424as_init_bridge(struct mipi_dsi_multi_context *ctx)
+{
+	/* DSI receiver / PPI timing */
+	tc_write(ctx, 0x013c, 0x000a000c);	/* PPI_TX_RX_TA */
+	tc_write(ctx, 0x0114, 0x00000008);	/* PPI_LPTXTIMECNT */
+	tc_write(ctx, 0x0164, 0x0000000f);	/* PPI_D0S_CLRSIPOCOUNT */
+	tc_write(ctx, 0x0168, 0x0000000f);	/* PPI_D1S_CLRSIPOCOUNT */
+	tc_write(ctx, 0x016c, 0x0000000f);	/* PPI_D2S_CLRSIPOCOUNT */
+	tc_write(ctx, 0x0170, 0x0000000f);	/* PPI_D3S_CLRSIPOCOUNT */
+	tc_write(ctx, 0x0134, 0x0000001f);	/* PPI_LANEENABLE */
+	tc_write(ctx, 0x0210, 0x0000001f);	/* DSI_LANEENABLE */
+	tc_write(ctx, 0x0104, 0x00000001);	/* PPI_STARTPPI */
+	tc_write(ctx, 0x0204, 0x00000001);	/* DSI_STARTDSI */
+
+	/* Video path timing, 1920x1080 */
+	tc_write(ctx, 0x0450, 0x03f00120);	/* VPCTRL */
+	tc_write(ctx, 0x0454, 0x00460028);	/* HTIM1: HBP 70, HSW 40 */
+	tc_write(ctx, 0x0458, 0x00460780);	/* HTIM2: HFP 70, HACT 1920 */
+	tc_write(ctx, 0x045c, 0x000a0005);	/* VTIM1: VBP 10, VSW 5 */
+	tc_write(ctx, 0x0460, 0x000f0438);	/* VTIM2: VFP 15, VACT 1080 */
+	tc_write(ctx, 0x0464, 0x00000001);	/* VFUEN */
+
+	/* LVDS PHY reset, then release */
+	tc_write(ctx, 0x04a0, 0x00448006);	/* LVPHY0 */
+	tc_write(ctx, 0x04a0, 0x00048006);	/* LVPHY0 */
+	tc_write(ctx, 0x0504, 0x00000004);	/* SYSRST: LVDS logic */
+
+	/* LVDS bit mapping */
+	tc_write(ctx, 0x0480, 0x03020200);	/* LV_MX0003 */
+	tc_write(ctx, 0x0484, 0x08050704);	/* LV_MX0407 */
+	tc_write(ctx, 0x0488, 0x0f0e0a09);	/* LV_MX0811 */
+	tc_write(ctx, 0x048c, 0x100d0c0b);	/* LV_MX1215 */
+	tc_write(ctx, 0x0490, 0x12111716);	/* LV_MX1619 */
+	tc_write(ctx, 0x0494, 0x1b151413);	/* LV_MX2023 */
+	tc_write(ctx, 0x0498, 0x061a1918);	/* LV_MX2427 */
+
+	/* Enable dual-link LVDS output */
+	tc_write(ctx, 0x049c, 0x00000033);	/* LVCFG */
+	mipi_dsi_msleep(ctx, 50);
+}
+
+static int tw2424as_prepare(struct drm_panel *panel)
+{
+	struct tw2424as *ctx = panel_to_tw2424as(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* Let the bridge settle on the HS clock started by the DSI host */
+	msleep(20);
+	tw2424as_init_bridge(&dsi_ctx);
+
+	if (dsi_ctx.accum_err)
+		dev_err(panel->dev, "failed to program bridge: %d\n", dsi_ctx.accum_err);
+
+	return dsi_ctx.accum_err;
+}
+
+static int tw2424as_unprepare(struct drm_panel *panel)
+{
+	struct tw2424as *ctx = panel_to_tw2424as(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* Switch the LVDS output off; keep the bridge out of reset (see above) */
+	tc_write(&dsi_ctx, 0x049c, 0x00000000);	/* LVCFG */
+
+	return 0;
+}
+
+/* Matches the vendor timing: 2100 x 1110 @ 137.86 MHz = 59.1 Hz */
+static const struct drm_display_mode tw2424as_mode = {
+	.clock = 137860,
+
+	.hdisplay = 1920,
+	.hsync_start = 1920 + 70,
+	.hsync_end = 1920 + 70 + 40,
+	.htotal = 1920 + 70 + 40 + 70,
+
+	.vdisplay = 1080,
+	.vsync_start = 1080 + 15,
+	.vsync_end = 1080 + 15 + 5,
+	.vtotal = 1080 + 15 + 5 + 10,
+
+	.width_mm = 527,
+	.height_mm = 296,
+	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int tw2424as_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	struct tw2424as *ctx = panel_to_tw2424as(panel);
+	int count;
+
+	count = drm_connector_helper_get_modes_fixed(connector, &tw2424as_mode);
+	connector->display_info.bpc = 8;
+	drm_connector_set_panel_orientation(connector, ctx->orientation);
+
+	return count;
+}
+
+static enum drm_panel_orientation tw2424as_get_orientation(struct drm_panel *panel)
+{
+	return panel_to_tw2424as(panel)->orientation;
+}
+
+static const struct drm_panel_funcs tw2424as_funcs = {
+	.prepare = tw2424as_prepare,
+	.unprepare = tw2424as_unprepare,
+	.get_modes = tw2424as_get_modes,
+	.get_orientation = tw2424as_get_orientation,
+};
+
+static int tw2424as_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct tw2424as *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct tw2424as, panel,
+				   &tw2424as_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+	mipi_dsi_set_drvdata(dsi, ctx);
+	ctx->dsi = dsi;
+
+	ctx->power = devm_regulator_get(dev, "power");
+	if (IS_ERR(ctx->power))
+		return dev_err_probe(dev, PTR_ERR(ctx->power),
+				     "failed to get power supply\n");
+
+	/* Hold the bridge in reset until it is powered */
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset),
+				     "failed to get reset GPIO\n");
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get orientation\n");
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return ret;
+
+	/*
+	 * Power up and release the bridge reset now, while the DSI clock lane
+	 * is still in LP-11; see the comment at the top of this file.
+	 */
+	ret = regulator_enable(ctx->power);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable power supply\n");
+	msleep(120);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(120);
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = devm_drm_panel_add(dev, &ctx->panel);
+	if (ret)
+		goto err_power;
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_MODE_LPM;
+
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret)
+		goto err_power;
+
+	return 0;
+
+err_power:
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	regulator_disable(ctx->power);
+	return ret;
+}
+
+static void tw2424as_remove(struct mipi_dsi_device *dsi)
+{
+	struct tw2424as *ctx = mipi_dsi_get_drvdata(dsi);
+
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	regulator_disable(ctx->power);
+}
+
+static const struct of_device_id tw2424as_of_match[] = {
+	{ .compatible = "iiyama,tw2424as-panel" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tw2424as_of_match);
+
+static struct mipi_dsi_driver tw2424as_driver = {
+	.probe = tw2424as_probe,
+	.remove = tw2424as_remove,
+	.driver = {
+		.name = "panel-iiyama-tw2424as",
+		.of_match_table = tw2424as_of_match,
+	},
+};
+module_mipi_dsi_driver(tw2424as_driver);
+
+MODULE_DESCRIPTION("iiyama ProLite TW2424AS panel (TC358775 over DSI)");
+MODULE_LICENSE("GPL");
