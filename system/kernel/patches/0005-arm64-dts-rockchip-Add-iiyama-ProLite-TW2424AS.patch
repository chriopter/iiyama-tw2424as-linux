+&pmugrf {
+	/* Magic values understood by the vendor U-Boot */
+	reboot_mode: reboot-mode {
+		compatible = "syscon-reboot-mode";
+		offset = <0x300>;
+		mode-bootloader = <BOOT_FASTBOOT>;	/* U-Boot fastboot */
+		mode-fastboot = <BOOT_FASTBOOT>;
+		mode-loader = <BOOT_BL_DOWNLOAD>;	/* Rockusb */
+		mode-normal = <BOOT_NORMAL>;
+		mode-recovery = <BOOT_RECOVERY>;
+		mode-ums = <(REBOOT_FLAG + 0xc)>;	/* U-Boot USB mass storage */
+	};
+};
+
+&pmu_io_domains {
+	pmu1830-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+&pwm2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm2_pin_pull_down>;
+	status = "okay";
+};
+
+&saradc {
+	vref-supply = <&vcc_1v8>;
+	status = "okay";
+};
