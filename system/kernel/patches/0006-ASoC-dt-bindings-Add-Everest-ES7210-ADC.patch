From ea49765779ae62d0f8c065d6c544751ccc56cbc4 Mon Sep 17 00:00:00 2001
From: chriopter <82179548+chriopter@users.noreply.github.com>
Date: Wed, 30 Sep 2026 01:39:52 +0200
Subject: [PATCH 06/12] ASoC: dt-bindings: Add Everest ES7210 ADC

Add the binding for the Everest Semiconductor ES7210, a 4-channel audio
ADC for microphone arrays with an I2C control interface.
---
 .../bindings/sound/everest,es7210.yaml        | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/everest,es7210.yaml

diff --git a/Documentation/devicetree/bindings/sound/everest,es7210.yaml b/Documentation/devicetree/bindings/sound/everest,es7210.yaml
new file mode 100644
index 000000000..71ce9a7d5
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/everest,es7210.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/everest,es7210.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Everest ES7210 4-channel audio ADC
+
+maintainers:
+  - chriopter <82179548+chriopter@users.noreply.github.com>
+
+description: |
+  Everest ES7210 4-channel audio ADC for microphone arrays, controlled over
+  I2C. In the standard serial formats it outputs ADC1/ADC2 on SDOUT1 and
+  ADC3/ADC4 on SDOUT2.
+
+  Pins on the device (for linking into audio routes):
+
+    Inputs:
+      * MIC1:     Microphone 1 input
+      * MIC2:     Microphone 2 input
+      * MIC3:     Microphone 3 input
+      * MIC4:     Microphone 4 input
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: everest,es7210
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: clock for master clock (MCLK)
+
+  clock-names:
+    items:
+      - const: mclk
+
+  port:
+    $ref: audio-graph-port.yaml#
+    unevaluatedProperties: false
+
+  "#sound-dai-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - "#sound-dai-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      audio-codec@40 {
+        compatible = "everest,es7210";
+        reg = <0x40>;
+        clocks = <&cru 10>;
+        clock-names = "mclk";
+        #sound-dai-cells = <0>;
+      };
+    };
