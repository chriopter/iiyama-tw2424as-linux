# iiyama ProLite TW2424AS: additions on top of arm64 defconfig
# Display: DSI panel behind TC358775, mounted upside down
CONFIG_DRM_PANEL_IIYAMA_TW2424AS=m
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_BACKLIGHT_PWM=m
CONFIG_DRM_PANFROST=m
# PMIC, regulators, RTC, keys
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_RTC_DRV_HYM8563=y
CONFIG_KEYBOARD_ADC=m
CONFIG_ROCKCHIP_SARADC=m
# WiFi/BT: AMPAK AP6256 (BCM43456 / BCM4345C5)
CONFIG_BRCMFMAC=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
# Ethernet PHY, audio, touch
CONFIG_MOTORCOMM_PHY=y
CONFIG_SND_SOC_ES8316=m
CONFIG_SND_SIMPLE_CARD=m
# Microphone array: ES7210 as second codec on i2s0 (multi-codec link needs audio-graph-card2)
CONFIG_SND_SOC_ES7210=m
CONFIG_SND_AUDIO_GRAPH_CARD2=m
CONFIG_HID_MULTITOUCH=y
# Maintenance: USB gadget (NCM + ACM), reboot modes, crash logs, watchdog
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_DW_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
# 24/7 operation: reboot (panic=10 on the cmdline) instead of hanging on lockups or oopses
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_PANIC_ON_OOPS=y
# Video decoder (H.264/HEVC/VP9, V4L2); also lets the VPU power domain reach sync_state
CONFIG_VIDEO_ROCKCHIP_VDEC=m
# Loudspeaker amplifier enable GPIO (switched by DAPM only while audio plays)
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m
# Release string: 7.2.8-iiyama-<build id> (build id appended by build.sh)
# CONFIG_LOCALVERSION_AUTO is not set
# pwrseq-simple reset-gpios go through the reset framework (WiFi power sequence)
CONFIG_RESET_GPIO=y
# Thermal protection and throttling from the first second
CONFIG_ROCKCHIP_THERMAL=y
