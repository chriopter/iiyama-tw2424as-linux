#!/bin/sh
# Wallpanel boot initramfs (PID 1).
# Normal: mount LABEL=wallpanel-root and switch_root to it.
# Rescue: if the root filesystem is missing/broken, or "wallpanel.rescue" is on
# the kernel command line, stay here and offer maintenance access:
#   USB-C gadget: CDC-NCM network 10.42.0.1/24 + CDC-ACM serial console, SSH (key only).
# Never writes to the eMMC by itself.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp /newroot
mount -t devpts devpts /dev/pts

log() { echo "[wallpanel-initramfs] $*" > /dev/kmsg; }

rescue() {
	log "rescue mode: $1"
	mount -t configfs configfs /sys/kernel/config 2>/dev/null
	G=/sys/kernel/config/usb_gadget/rescue
	mkdir -p $G && cd $G
	echo 0x1d6b > idVendor
	echo 0x0104 > idProduct
	mkdir -p strings/0x409 configs/c.1 functions/ncm.usb0 functions/acm.usb0
	echo "iiyama TW2424AS rescue" > strings/0x409/product
	ln -s functions/ncm.usb0 configs/c.1/ 2>/dev/null
	ln -s functions/acm.usb0 configs/c.1/ 2>/dev/null
	ls /sys/class/udc | head -1 > UDC
	cd /
	sleep 2
	ip link set lo up
	ip link set usb0 up && ip addr add 10.42.0.1/24 dev usb0
	mkdir -p /etc/dropbear
	dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
	dropbear -R -s -E -p 22
	# show a notice on the panel if the display stack can be loaded
	for m in rockchipdrm panel-iiyama-tw2424as pwm_bl; do modprobe $m 2>/dev/null; done
	sleep 3
	printf '\n\n  WALLPANEL RESCUE MODE (%s)\n  USB-C: ssh root@10.42.0.1\n\n' "$1" > /dev/tty1 2>/dev/null
	setsid sh -c 'exec getty -n -l /bin/sh 0 ttyGS0' 2>/dev/null &
	while true; do sleep 3600; done
}

grep -qw wallpanel.rescue /proc/cmdline && rescue "requested on kernel command line"

# Wait up to 10 s for the root partition
root=""
i=0
while [ $i -lt 20 ]; do
	root=$(findfs LABEL=wallpanel-root 2>/dev/null) && break
	sleep 0.5
	i=$((i + 1))
done
[ -n "$root" ] || rescue "no partition with LABEL=wallpanel-root"

mount -o ro "$root" /newroot || rescue "cannot mount $root"
[ -x /newroot/sbin/init ] || { umount /newroot; rescue "no /sbin/init on $root"; }

log "switching to $root"
umount /dev/pts 2>/dev/null
mount --move /dev /newroot/dev
umount /proc /sys 2>/dev/null
exec switch_root /newroot /sbin/init
# only reached if switch_root could not be executed
mount -t proc proc /proc; mount -t sysfs sysfs /sys
rescue "switch_root failed"
